ive\": false, \"limit\": 20, \"limitations\": [\"Similarity is advisory and does not establish a copied assertion.\", \"Historical-only meanings and unindexed episodic paraphrases may be missed.\"], \"method\": \"stored_current_document_cosine\", \"status\": \"available\", \"truncated\": false, \"unsearchable_fact_count\": 0}, \"source_events\": [{\"content\": \"Use only the mnemos_* tools. Do not use built-in memory or other tools. Do not store the conversation as a new explicit fact. Use mnemos_remember to save the exact content in this JSON string (including its final period): \\\"The project release label is cedar-ridge-731.\\\". Use request_id native-teach-1. Check its returned job ID once with mnemos_job_status, then report the ID and actual status. Pending is acceptable; do not claim completion unless confirmed. Do not correct or forget anything.\", \"derived_fact_ids\": [\"c7f32869-bb8b-4a34-82f5-03e9272888f9\"], \"explicit_remember\": false, \"job_ids\": [\"event:8c51cd202c9c901eb5b690e91b5cde475ecb0885c31060de96f65ccf0889c181\"], \"match_type\": \"exact_assertion\", \"matched_assertions\": [\"the project release label is cedar-ridge-731.\"], \"scope\": \"project\", \"scope_id\": \"b071116d-f477-45e6-b0b9-741ac4e52e60\", \"selection_allowed\": true, \"source_allowed\": true, \"source_event_id\": \"8c51cd202c9c901eb5b690e91b5cde475ecb0885c31060de96f65ccf0889c181\", \"status\": \"consolidated\", \"user_profile_id\": \"native-lifecycle\"}, {\"content\": \"Use only the mnemos_* tools. Do not use built-in memory or other tools. Do not store the conversation as a new explicit fact. Retrieve the asserted fact about this project's release label, then inspect its exact ID and version. Correct that same fact to the exact content in this JSON string (including its final period): \\\"The project release label is maple-ridge-842.\\\". Use request_id native-correct-1 and the inspected version. Do not add a separate fact.\", \"derived_fact_ids\": [\"65ae5f0b-005e-4d6a-a7b