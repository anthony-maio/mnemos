{
  "name": "mnemos-memory",
  "version": "0.7.0-beta.1",
  "description": "Scoped local memory with MCP tools and experimental memory enrichment. Evaluation preview.",
  "author": {
    "name": "Anthony Maio",
    "email": "anthony@making-minds.ai",
    "url": "https://github.com/anthony-maio/mnemos"
  },
  "homepage": "https://github.com/anthony-maio/mnemos",
  "repository": "https://github.com/anthony-maio/mnemos",
  "license": "MIT",
  "keywords": [
    "memory",
    "mcp",
    "claude-code",
    "biomimetic",
    "rag",
    "surprisal",
    "reconsolidation"
  ],
  "commands": "./commands",
  "agents": [
    "./agents/memory-orchestrator.md",
    "./agents/mnemos-recall.md",
    "./agents/mnemos-curator.md"
  ],
  "mcpServers": {
    "mnemos": {
      "command": "python",
      "alwaysLoad": true,
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/.claude-plugin/run_mnemos_mcp.py"
      ]
    }
  }
}
